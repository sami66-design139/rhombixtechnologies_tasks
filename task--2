#include <fstream>
#include <iostream>
#include <iterator>
#include <sstream>
#include <string>

int readMenuChoice() {
    std::string input;
    std::cout << "\n1. Encrypt a file\n"
              << "2. Decrypt a file\n"
              << "3. Exit\n"
              << "Choose an option: ";

    if (!std::getline(std::cin, input)) {
        return 3;
    }

    std::istringstream parser(input);
    int choice = 0;
    char extra = '\0';
    if (parser >> choice && !(parser >> extra)) {
        return choice;
    }
    return 0;
}

bool readShift(int& shift) {
    std::string input;
    std::cout << "Enter the shift amount (a whole number): ";
    if (!std::getline(std::cin, input)) {
        return false;
    }

    std::istringstream parser(input);
    char extra = '\0';
    if (!(parser >> shift) || (parser >> extra)) {
        std::cout << "Invalid shift amount.\n";
        return false;
    }
    return true;
}

std::string caesarCipher(const std::string& text, int shift, bool decrypt) {
    int normalizedShift = shift % 26;
    if (normalizedShift < 0) {
        normalizedShift += 26;
    }
    if (decrypt) {
        normalizedShift = (26 - normalizedShift) % 26;
    }

    std::string result = text;
    for (char& character : result) {
        if (character >= 'A' && character <= 'Z') {
            character = static_cast<char>(
                'A' + (character - 'A' + normalizedShift) % 26);
        } else if (character >= 'a' && character <= 'z') {
            character = static_cast<char>(
                'a' + (character - 'a' + normalizedShift) % 26);
        }
    }
    return result;
}

void processFile(bool decrypt) {
    std::string inputPath;
    std::string outputPath;
    std::cout << "Enter the input file path: ";
    if (!std::getline(std::cin, inputPath)) {
        return;
    }
    std::cout << "Enter the output file path: ";
    if (!std::getline(std::cin, outputPath)) {
        return;
    }

    if (inputPath.empty() || outputPath.empty()) {
        std::cout << "File paths cannot be empty.\n";
        return;
    }

    int shift = 0;
    if (!readShift(shift)) {
        return;
    }

    std::ifstream input(inputPath, std::ios::binary);
    if (!input) {
        std::cout << "Could not open the input file.\n";
        return;
    }

    const std::string contents{std::istreambuf_iterator<char>(input),
                               std::istreambuf_iterator<char>()};
    if (input.bad()) {
        std::cout << "Could not read the input file.\n";
        return;
    }
    input.close();

    const std::string transformed = caesarCipher(contents, shift, decrypt);
    std::ofstream output(outputPath, std::ios::binary);
    if (!output) {
        std::cout << "Could not open the output file.\n";
        return;
    }
    output.write(transformed.data(),
                 static_cast<std::streamsize>(transformed.size()));
    if (!output) {
        std::cout << "Could not write the output file.\n";
        return;
    }

    std::cout << (decrypt ? "File decrypted" : "File encrypted")
              << " successfully.\n";
    std::cout << "Note: Caesar cipher is for learning only and is not secure "
                 "for protecting sensitive data.\n";
}

int main() {
    while (true) {
        switch (readMenuChoice()) {
            case 1:
                processFile(false);
                break;
            case 2:
                processFile(true);
                break;
            case 3:
                std::cout << "Goodbye!\n";
                return 0;
            default:
                std::cout << "Invalid option. Please choose 1-3.\n";
                break;
        }
    }
}
