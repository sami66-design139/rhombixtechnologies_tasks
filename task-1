// Task 1: Console-based To-Do List Application
// Build: g++ -std=c++17 -o todo todo.cpp
#include <fstream>
#include <iostream>
#include <limits>
#include <string>
#include <vector>

struct Task {
    std::string text;
    bool done = false;
};

const std::string FILE_NAME = "tasks.txt";

void loadTasks(std::vector<Task>& tasks) {
    std::ifstream in(FILE_NAME);
    std::string line;
    while (std::getline(in, line)) {
        if (line.size() < 3) continue;
        tasks.push_back({line.substr(2), line[0] == '1'});
    }
}

void saveTasks(const std::vector<Task>& tasks) {
    std::ofstream out(FILE_NAME);
    for (const auto& t : tasks) out << (t.done ? '1' : '0') << '|' << t.text << '\n';
}

void viewTasks(const std::vector<Task>& tasks) {
    if (tasks.empty()) {
        std::cout << "No tasks yet.\n";
        return;
    }
    for (size_t i = 0; i < tasks.size(); ++i)
        std::cout << i + 1 << ". [" << (tasks[i].done ? 'x' : ' ') << "] " << tasks[i].text << '\n';
}

int main() {
    std::vector<Task> tasks;
    loadTasks(tasks);

    while (true) {
        std::cout << "\n=== To-Do List ===\n"
                  << "1. Add task\n2. Mark task completed\n3. View tasks\n4. Delete task\n5. Exit\n"
                  << "Choice: ";
        int choice;
        if (!(std::cin >> choice)) {
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Invalid input.\n";
            continue;
        }
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');

        if (choice == 1) {
            std::cout << "Task description: ";
            std::string text;
            std::getline(std::cin, text);
            if (text.empty()) {
                std::cout << "Task cannot be empty.\n";
            } else {
                tasks.push_back({text, false});
                saveTasks(tasks);
                std::cout << "Added.\n";
            }
        } else if (choice == 2 || choice == 4) {
            viewTasks(tasks);
            if (tasks.empty()) continue;
            std::cout << "Task number: ";
            size_t n;
            if (!(std::cin >> n) || n < 1 || n > tasks.size()) {
                std::cin.clear();
                std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
                std::cout << "Invalid task number.\n";
                continue;
            }
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            if (choice == 2) {
                tasks[n - 1].done = true;
                std::cout << "Marked as completed.\n";
            } else {
                tasks.erase(tasks.begin() + (n - 1));
                std::cout << "Deleted.\n";
            }
            saveTasks(tasks);
        } else if (choice == 3) {
            viewTasks(tasks);
        } else if (choice == 5) {
            saveTasks(tasks);
            std::cout << "Goodbye!\n";
            break;
        } else {
            std::cout << "Invalid choice.\n";
        }
    }
    return 0;
}
